MERGE (n:Evaluation {canonical_id: 'eval_27ff5d7c6c7c'}) ON CREATE SET n.smr_niveau = 'Important', n.asmr_valeur = 'III', n.asmr_signification = 'XALKORI apporte une amélioration du service médical rendu modérée (niveau III) dans la stratégie de prise en charge du cancer bronchique non à petites cellules ALK+ au stade avancé en deuxième ligne et par rapport au docétaxel ou au pemetrexed.', n.date_avis = '2013-04-03', n.date_avis_precision = 'jour', n.type_avis = 'primo-inscription', n.ligne_traitement = 'deuxième ligne, après échec d\'un traitement antérieur', n.justification = 'Le cancer bronchique non à petites cellules ALK+ avancé est une affection grave sans alternative ciblant spécifiquement la mutation ALK. L\'étude de phase III versus chimiothérapie montre un gain de 4,7 mois de survie sans progression et une amélioration de la réponse objective, sans différence de survie globale, justifiant un SMR important et une ASMR modérée (III).', n.document_id = 'CT-12648_XALKORI Ins_Avis2_CT12648', n.titre = 'XALKORI 200 mg, gélule / XALKORI 250 mg, gélule' ON MATCH SET n.smr_niveau = 'Important', n.asmr_valeur = 'III', n.asmr_signification = 'XALKORI apporte une amélioration du service médical rendu modérée (niveau III) dans la stratégie de prise en charge du cancer bronchique non à petites cellules ALK+ au stade avancé en deuxième ligne et par rapport au docétaxel ou au pemetrexed.', n.date_avis = '2013-04-03', n.date_avis_precision = 'jour', n.type_avis = 'primo-inscription', n.ligne_traitement = 'deuxième ligne, après échec d\'un traitement antérieur', n.justification = 'Le cancer bronchique non à petites cellules ALK+ avancé est une affection grave sans alternative ciblant spécifiquement la mutation ALK. L\'étude de phase III versus chimiothérapie montre un gain de 4,7 mois de survie sans progression et une amélioration de la réponse objective, sans différence de survie globale, justifiant un SMR important et une ASMR modérée (III).', n.document_id = 'CT-12648_XALKORI Ins_Avis2_CT12648', n.titre = 'XALKORI 200 mg, gélule / XALKORI 250 mg, gélule';
