MERGE (n:Pathologie {canonical_id: 'l20'}) ON CREATE SET n.nom = 'Dermatite atopique modérée à sévère de l\'adulte en échec des traitements topiques et naïfs de traitements systémiques', n.icd10 = 'L20', n.categorie = 'dermatologie', n.severite = 'modérée à sévère' ON MATCH SET n.nom = 'Dermatite atopique modérée à sévère de l\'adulte en échec des traitements topiques et naïfs de traitements systémiques', n.icd10 = 'L20', n.categorie = 'dermatologie', n.severite = 'modérée à sévère';
