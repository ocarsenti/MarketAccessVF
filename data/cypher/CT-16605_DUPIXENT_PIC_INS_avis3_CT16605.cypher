MERGE (n:Evaluation {canonical_id: 'eval_dfb5683fcb9f'}) ON CREATE SET n.smr_niveau = 'Insuffisant', n.asmr_valeur = 'NA', n.asmr_signification = null, n.date_avis = '2018-07-11', n.date_avis_precision = 'jour', n.type_avis = 'primo-inscription', n.ligne_traitement = 'Première intention de traitement systémique après échec des traitements topiques', n.justification = 'En l\'absence de données comparatives robustes versus ciclosporine par voie orale, seul médicament ayant l\'AMM en première intention et alternative disponible, le SMR de DUPIXENT est jugé insuffisant pour justifier une prise en charge par la solidarité nationale chez les adultes naïfs de traitement systémique.', n.document_id = 'CT-16605_DUPIXENT_PIC_INS_avis3_CT16605', n.titre = 'DUPIXENT 300 mg, solution injectable en seringue pré-remplie - dupilumab', n.population_cible_min = null, n.population_cible_max = null, n.population_cible_texte_brut = null, n.population_cible_source_type = null, n.population_cible_commentaire_commission = null ON MATCH SET n.smr_niveau = 'Insuffisant', n.asmr_valeur = 'NA', n.asmr_signification = null, n.date_avis = '2018-07-11', n.date_avis_precision = 'jour', n.type_avis = 'primo-inscription', n.ligne_traitement = 'Première intention de traitement systémique après échec des traitements topiques', n.justification = 'En l\'absence de données comparatives robustes versus ciclosporine par voie orale, seul médicament ayant l\'AMM en première intention et alternative disponible, le SMR de DUPIXENT est jugé insuffisant pour justifier une prise en charge par la solidarité nationale chez les adultes naïfs de traitement systémique.', n.document_id = 'CT-16605_DUPIXENT_PIC_INS_avis3_CT16605', n.titre = 'DUPIXENT 300 mg, solution injectable en seringue pré-remplie - dupilumab', n.population_cible_min = null, n.population_cible_max = null, n.population_cible_texte_brut = null, n.population_cible_source_type = null, n.population_cible_commentaire_commission = null;
