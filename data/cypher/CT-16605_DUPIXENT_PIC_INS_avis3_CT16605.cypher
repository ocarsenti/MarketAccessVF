MATCH (e:Evaluation {canonical_id: 'eval_dfb5683fcb9f'}), (c:Comparateur {canonical_id: 'ciclosporine'}) MERGE (e)-[r:COMPARE_A]->(c) SET r += {en_association_avec: null, role: 'Comparateur cliniquement pertinent, seul traitement ayant l\'AMM en première intention, non comparé directement au dupilumab', endpoint_principal: null, endpoint_secondaires: [], resultat_principal: null, resultat_secondaires: null, evidence_excerpt: 'Les médicaments recommandés chez les patients atteints de DA modérée à sévère chez qui un traitement systémique est nécessaire sont représentés par les médicaments à base de ciclosporine principalement, les seuls ayant l\'AMM dans la prise en charge de la DA.'};
