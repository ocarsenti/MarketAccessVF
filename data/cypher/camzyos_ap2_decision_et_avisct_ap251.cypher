MERGE (n:Argument {canonical_id: 'arg_51f80a1fb222c01c'}) ON CREATE SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'maladie_grave_pronostic_vital', n.label = 'Maladie grave engageant le pronostic vital' ON MATCH SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'maladie_grave_pronostic_vital', n.label = 'Maladie grave engageant le pronostic vital';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_51f80a1fb222c01c'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'La CMHo constitue une maladie grave, rare et invalidante pouvant se compliquer de troubles du rythme ventriculaire et être une cause principale de mort subite du sujet jeune.'};
MERGE (n:Argument {canonical_id: 'arg_7a9d6b7e4fcbcc7c'}) ON CREATE SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'absence_alternative_therapeutique', n.label = 'Absence d\'alternative therapeutique' ON MATCH SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'absence_alternative_therapeutique', n.label = 'Absence d\'alternative therapeutique';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_7a9d6b7e4fcbcc7c'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Il n\'existe pas de traitement médicamenteux approprié chez les patients ayant des symptômes de CMHo persistants malgré un traitement de fond optimisé ; seuls des traitements ablatifs non médicamenteux (myomectomie, alcoolisation septale) associés à une morbi-mortalité non négligeable sont proposés.'};
MERGE (n:Argument {canonical_id: 'arg_8097e52402494238'}) ON CREATE SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'besoin_partiellement_couvert', n.label = 'Besoin medical partiellement couvert' ON MATCH SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'besoin_partiellement_couvert', n.label = 'Besoin medical partiellement couvert';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_8097e52402494238'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Le besoin médical est actuellement partiellement couvert par les alternatives disponibles ; il persiste un besoin de traitements efficaces, bien tolérés et limitant le recours aux procédures invasives.'};
MERGE (n:Argument {canonical_id: 'arg_51f80a1fb222c01c'}) ON CREATE SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'maladie_grave_pronostic_vital', n.label = 'Maladie grave engageant le pronostic vital' ON MATCH SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'maladie_grave_pronostic_vital', n.label = 'Maladie grave engageant le pronostic vital';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_51f80a1fb222c01c'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'La mise en œuvre du traitement ne peut pas être différée car le retard expose au prolongement des symptômes, à une aggravation du pronostic, au déconditionnement à l\'effort et au remodelage ventriculaire favorisant l\'insuffisance cardiaque.'};
MERGE (n:Argument {canonical_id: 'arg_0c63c3a10e727630'}) ON CREATE SET n.categorie = 'efficacite', n.orientation = 'favorable', n.type_argument = 'superiorite_demontree', n.label = 'Superiorite demontree sur le critere principal' ON MATCH SET n.categorie = 'efficacite', n.orientation = 'favorable', n.type_argument = 'superiorite_demontree', n.label = 'Superiorite demontree sur le critere principal';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_0c63c3a10e727630'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Dans l\'étude EXPLORER-HCM, le mavacamten a démontré sa supériorité par rapport au placebo sur le critère composite associant pic de VO2 et classe NYHA (36,6% vs 17,2%, différence 19,4% [8,67;30,13], p=0,0005).'};
MERGE (n:Argument {canonical_id: 'arg_0c63c3a10e727630'}) ON CREATE SET n.categorie = 'efficacite', n.orientation = 'favorable', n.type_argument = 'superiorite_demontree', n.label = 'Superiorite demontree sur le critere principal' ON MATCH SET n.categorie = 'efficacite', n.orientation = 'favorable', n.type_argument = 'superiorite_demontree', n.label = 'Superiorite demontree sur le critere principal';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_0c63c3a10e727630'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Dans l\'étude VALOR-HCM, le mavacamten a démontré sa supériorité par rapport au placebo sur la réduction du nombre de procédures de réduction septale (17,9% vs 76,8%, différence 58,9% [44,0;73,9], p<0,0001).'};
MERGE (n:Argument {canonical_id: 'arg_8097e52402494238'}) ON CREATE SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'besoin_partiellement_couvert', n.label = 'Besoin medical partiellement couvert' ON MATCH SET n.categorie = 'besoin_medical_non_couvert', n.orientation = 'favorable', n.type_argument = 'besoin_partiellement_couvert', n.label = 'Besoin medical partiellement couvert';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_8097e52402494238'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Le médicament dispose d\'un plan de développement adapté et présente des résultats cliniques étayant la présomption d\'un bénéfice pour le patient et comble un besoin médical insuffisamment couvert.'};
MERGE (n:Argument {canonical_id: 'arg_2070e16cd6fd6c54'}) ON CREATE SET n.categorie = 'securite', n.orientation = 'favorable', n.type_argument = 'profil_tolerance_favorable', n.label = 'Profil de tolerance favorable' ON MATCH SET n.categorie = 'securite', n.orientation = 'favorable', n.type_argument = 'profil_tolerance_favorable', n.label = 'Profil de tolerance favorable';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_2070e16cd6fd6c54'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Le profil de tolérance du mavacamten semble acceptable et comparable à celui du placebo dans les études cliniques.'};
MERGE (n:Argument {canonical_id: 'arg_a80413f9cb8ca2ba'}) ON CREATE SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'absence_comparateur_direct', n.label = 'Absence de comparaison directe avec le traitement de reference' ON MATCH SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'absence_comparateur_direct', n.label = 'Absence de comparaison directe avec le traitement de reference';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_a80413f9cb8ca2ba'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Aucune étude comparative n\'a été réalisée avec les autres traitements recommandés et utilisés en pratique clinique dans la CMHo (bêta-bloquants, vérapamil, diltiazem, disopyramide).'};
MERGE (n:Argument {canonical_id: 'arg_ca7439653910902c'}) ON CREATE SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'critere_principal_inadapte', n.label = 'Critere de jugement principal juge inadapte' ON MATCH SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'critere_principal_inadapte', n.label = 'Critere de jugement principal juge inadapte';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_ca7439653910902c'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Aucune démonstration de l\'efficacité du mavacamten n\'a été réalisée sur des critères de morbi-mortalité et les données sont insuffisantes pour quantifier l\'ampleur du bénéfice clinique associé à l\'augmentation du pic de VO2.'};
MERGE (n:Argument {canonical_id: 'arg_d894502a649f3c13'}) ON CREATE SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'donnees_immatures', n.label = 'Donnees de survie/efficacite immatures' ON MATCH SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'donnees_immatures', n.label = 'Donnees de survie/efficacite immatures';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_d894502a649f3c13'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'La durée de suivi des études cliniques (30 semaines pour EXPLORER-HCM et 16 semaines pour VALOR-HCM) ne permet pas de conclure sur l\'efficacité et la sécurité à long terme du mavacamten.'};
MERGE (n:Argument {canonical_id: 'arg_daf65af884ac8025'}) ON CREATE SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'transposabilite_limitee', n.label = 'Transposabilite limitee a la pratique clinique francaise' ON MATCH SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'transposabilite_limitee', n.label = 'Transposabilite limitee a la pratique clinique francaise';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_daf65af884ac8025'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'La population des patients âgés de moins de 50 ans est mal représentée dans les études alors que la maladie est le plus souvent diagnostiquée chez le jeune adulte déjà symptomatique.'};
MERGE (n:Argument {canonical_id: 'arg_4b5b0c68ca7e0846'}) ON CREATE SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'extrapolation_hors_amm', n.label = 'Extrapolation au-dela des donnees/de l\'AMM' ON MATCH SET n.categorie = 'methodologie', n.orientation = 'defavorable', n.type_argument = 'extrapolation_hors_amm', n.label = 'Extrapolation au-dela des donnees/de l\'AMM';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_4b5b0c68ca7e0846'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'L\'efficacité du mavacamten n\'a pas été évaluée chez les patients ayant une forme sévère de CMHo (symptômes de classe NYHA IV, antécédents de syncope ou de tachycardie ventriculaire, TRS récente).'};
MERGE (n:Argument {canonical_id: 'arg_9dff99cd54154b0d'}) ON CREATE SET n.categorie = 'securite', n.orientation = 'defavorable', n.type_argument = 'donnees_securite_insuffisantes', n.label = 'Donnees de securite insuffisantes / recul limite' ON MATCH SET n.categorie = 'securite', n.orientation = 'defavorable', n.type_argument = 'donnees_securite_insuffisantes', n.label = 'Donnees de securite insuffisantes / recul limite';
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (a:Argument {canonical_id: 'arg_9dff99cd54154b0d'}) MERGE (e)-[r:INVOQUE]->(a) SET r += {texte: 'Un effet délétère du mavacamten sur la fonction cardiaque ne peut être exclu chez les sujets à risque (affection intercurrente grave, arythmie, chirurgie cardiaque majeure) car le médicament réduit la FEVG et pourrait provoquer une insuffisance cardiaque par dysfonctionnement systolique.'};
MERGE (n:Comparateur {canonical_id: 'placebo'}) ON CREATE SET n.nom = 'Placebo', n.dci = null, n.type_molecule = null ON MATCH SET n.nom = 'Placebo', n.dci = null, n.type_molecule = null;
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (c:Comparateur {canonical_id: 'placebo'}) MERGE (e)-[r:COMPARE_A]->(c) SET r += {en_association_avec: null, role: 'comparateur de l\'étude pivot EXPLORER-HCM', endpoint_principal: 'critère composite : variation du pic de VO2 et amélioration de la classe NYHA à la semaine 30', endpoint_secondaires: ['variation du gradient CCVG maximal post-exercice', 'variation du pic de VO2', 'pourcentage de patients avec amélioration de la classe NYHA ≥ 1', 'variation du score CSS du questionnaire KCCQ-23', 'variation du score de domaine de l\'essoufflement du questionnaire HCMSQ'], resultat_principal: '36,6% (mavacamten) vs 17,2% (placebo) ; différence 19,4% IC95% [8,67 ; 30,13] ; p = 0,0005', resultat_secondaires: 'Supériorité du mavacamten sur tous les critères secondaires hiérarchisés, notamment gradient CCVG (-35 mmHg vs placebo, p<0,0001) et score CSS KCCQ-23 (+9 points vs placebo, p<0,0001).', evidence_excerpt: '36,6% des patients dans le groupe mavacamten versus 17,2% des patients dans le groupe placebo ont présenté une augmentation ≥ 1,5 ml/kg/min de la du pic de VO2 associée à une amélioration d\'au moins une classe NYHA ou une augmentation ≥ 3,0 ml/kg/min du pic de VO2 sans aggravation de la classe NYHA, soit une différence statistiquement significative de 19,4 % (IC95% [8,67 ; 30,13] ; p = 0,0005).'};
MERGE (n:Comparateur {canonical_id: 'placebo'}) ON CREATE SET n.nom = 'Placebo', n.dci = null, n.type_molecule = null ON MATCH SET n.nom = 'Placebo', n.dci = null, n.type_molecule = null;
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (c:Comparateur {canonical_id: 'placebo'}) MERGE (e)-[r:COMPARE_A]->(c) SET r += {en_association_avec: null, role: 'comparateur de l\'étude pivot VALOR-HCM', endpoint_principal: 'proportion de patients ayant recours ou demeurant éligibles à une thérapie de réduction septale (TRS) à la semaine 16', endpoint_secondaires: ['variation du gradient CCVG maximal post-exercice', 'pourcentage de patients avec amélioration de la classe NYHA ≥ 1', 'variation du score CSS du questionnaire KCCQ-23', 'variation du NT-proBNP'], resultat_principal: '17,9% (mavacamten) vs 76,8% (placebo) ; différence 58,9% IC95% [44,0 ; 73,9] ; p < 0,0001', resultat_secondaires: 'Supériorité du mavacamten sur tous les critères secondaires hiérarchisés (gradient CCVG -37,2 mmHg vs placebo p<0,0001 ; NT-proBNP ratio 0,33 p<0,0001).', evidence_excerpt: '17,9 % des patients dans le groupe mavacamten versus 76,8% des patients dans le groupe placebo ont décidé de procéder à une TRS ou demeuraient éligibles […] à une TRS, soit une différence statistiquement significative de 58,9 % (IC95% [44,0 ; 73,9] ; p < 0,0001).'};
MERGE (n:Comparateur {canonical_id: 'beta_bloquant'}) ON CREATE SET n.nom = 'Bêta-bloquants (propranolol, nadolol, pindolol)', n.dci = 'bêta-bloquant', n.type_molecule = null ON MATCH SET n.nom = 'Bêta-bloquants (propranolol, nadolol, pindolol)', n.dci = 'bêta-bloquant', n.type_molecule = null;
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (c:Comparateur {canonical_id: 'beta_bloquant'}) MERGE (e)-[r:COMPARE_A]->(c) SET r += {en_association_avec: null, role: 'traitement de fond de première intention, alternative thérapeutique citée par la Commission (non comparée directement au mavacamten)', endpoint_principal: null, endpoint_secondaires: [], resultat_principal: null, resultat_secondaires: null, evidence_excerpt: 'Le traitement médical en cas de symptômes repose en 1ère intention sur l\'utilisation des bêta-bloquants (à l\'exception du sotalol).'};
MERGE (n:Comparateur {canonical_id: 'verapamil'}) ON CREATE SET n.nom = 'Vérapamil', n.dci = 'vérapamil', n.type_molecule = null ON MATCH SET n.nom = 'Vérapamil', n.dci = 'vérapamil', n.type_molecule = null;
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (c:Comparateur {canonical_id: 'verapamil'}) MERGE (e)-[r:COMPARE_A]->(c) SET r += {en_association_avec: null, role: 'alternative thérapeutique hors AMM citée par la Commission (non comparée directement au mavacamten)', endpoint_principal: null, endpoint_secondaires: [], resultat_principal: null, resultat_secondaires: null, evidence_excerpt: 'Chez les patients pour lesquels les bêta-bloquants sont contre-indiqués, inefficaces ou mal tolérés, l\'inhibiteur calcique vérapamil peut être proposé (utilisation hors AMM).'};
MERGE (n:Comparateur {canonical_id: 'disopyramide'}) ON CREATE SET n.nom = 'Disopyramide', n.dci = 'disopyramide', n.type_molecule = null ON MATCH SET n.nom = 'Disopyramide', n.dci = 'disopyramide', n.type_molecule = null;
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (c:Comparateur {canonical_id: 'disopyramide'}) MERGE (e)-[r:COMPARE_A]->(c) SET r += {en_association_avec: 'bêta-bloquant', role: 'alternative thérapeutique hors AMM de seconde intention, citée par la Commission (SMR jugé insuffisant dans un avis antérieur, non comparée directement au mavacamten)', endpoint_principal: null, endpoint_secondaires: [], resultat_principal: null, resultat_secondaires: null, evidence_excerpt: 'Chez les patients ayant des symptômes persistants malgré un traitement par bêta-bloquant ou vérapamil, les recommandations préconisent en seconde intention l\'ajout du disopyramide (hors AMM) en bithérapie avec un bêta-bloquant.'};
MERGE (n:Comparateur {canonical_id: 'myomectomie_chirurgicale'}) ON CREATE SET n.nom = 'Myomectomie chirurgicale / alcoolisation d\'artère coronaire septale', n.dci = null, n.type_molecule = null ON MATCH SET n.nom = 'Myomectomie chirurgicale / alcoolisation d\'artère coronaire septale', n.dci = null, n.type_molecule = null;
MATCH (e:Evaluation {canonical_id: 'eval_bac1498c3a48'}), (c:Comparateur {canonical_id: 'myomectomie_chirurgicale'}) MERGE (e)-[r:COMPARE_A]->(c) SET r += {en_association_avec: null, role: 'traitements non médicamenteux alternatifs cités par la Commission, associés à une morbi-mortalité non négligeable', endpoint_principal: null, endpoint_secondaires: [], resultat_principal: null, resultat_secondaires: null, evidence_excerpt: 'Lorsque le traitement médicamenteux est insuffisant, la chirurgie cardiaque (myotomie-myectomie) ou l\'alcoolisation septale sont proposées mais la morbi-mortalité de l\'ensemble de ces techniques ablatives n\'est toutefois pas négligeable.'};
