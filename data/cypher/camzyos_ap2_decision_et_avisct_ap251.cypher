MERGE (n:Evaluation {canonical_id: 'eval_bac1498c3a48'}) ON CREATE SET n.smr_niveau = null, n.asmr_valeur = 'NA', n.asmr_signification = 'Non applicable : il s\'agit d\'une autorisation d\'accès précoce post-AMM ; la Commission s\'est prononcée sur les critères d\'éligibilité (maladie grave/rare/invalidante, absence de traitement approprié, impossibilité de différer le traitement, caractère présumé innovant) et non sur un SMR/ASMR classique.', n.date_avis = '2023-09-06', n.date_avis_precision = 'jour', n.type_avis = 'acces-precoce', n.ligne_traitement = 'patients symptomatiques persistants malgré un traitement de fond optimisé par bêta-bloquant, vérapamil et/ou disopyramide', n.justification = 'La CMHo constitue une maladie grave, rare et invalidante pour laquelle il n\'existe pas de traitement médicamenteux approprié chez les patients symptomatiques persistants sous traitement de fond optimisé ; seuls des traitements ablatifs non médicamenteux à morbi-mortalité non négligeable sont disponibles. CAMZYOS est présumé innovant, avec des résultats cliniques étayant un bénéfice pour le patient et comblant un besoin médical insuffisamment couvert ; la mise en œuvre du traitement ne peut être différée.', n.document_id = 'camzyos_ap2_decision_et_avisct_ap251', n.titre = 'Décision n°2023.0329/DC/SEM du 21 septembre 2023 du collège de la Haute Autorité de santé portant autorisation d\'accès précoce de la spécialité CAMZYOS / Avis sur les médicaments CAMZYOS (mavacamten) - Commission de la Transparence du 6 septembre 2023', n.population_cible_min = null, n.population_cible_max = null, n.population_cible_texte_brut = null, n.population_cible_source_type = null, n.population_cible_commentaire_commission = null ON MATCH SET n.smr_niveau = null, n.asmr_valeur = 'NA', n.asmr_signification = 'Non applicable : il s\'agit d\'une autorisation d\'accès précoce post-AMM ; la Commission s\'est prononcée sur les critères d\'éligibilité (maladie grave/rare/invalidante, absence de traitement approprié, impossibilité de différer le traitement, caractère présumé innovant) et non sur un SMR/ASMR classique.', n.date_avis = '2023-09-06', n.date_avis_precision = 'jour', n.type_avis = 'acces-precoce', n.ligne_traitement = 'patients symptomatiques persistants malgré un traitement de fond optimisé par bêta-bloquant, vérapamil et/ou disopyramide', n.justification = 'La CMHo constitue une maladie grave, rare et invalidante pour laquelle il n\'existe pas de traitement médicamenteux approprié chez les patients symptomatiques persistants sous traitement de fond optimisé ; seuls des traitements ablatifs non médicamenteux à morbi-mortalité non négligeable sont disponibles. CAMZYOS est présumé innovant, avec des résultats cliniques étayant un bénéfice pour le patient et comblant un besoin médical insuffisamment couvert ; la mise en œuvre du traitement ne peut être différée.', n.document_id = 'camzyos_ap2_decision_et_avisct_ap251', n.titre = 'Décision n°2023.0329/DC/SEM du 21 septembre 2023 du collège de la Haute Autorité de santé portant autorisation d\'accès précoce de la spécialité CAMZYOS / Avis sur les médicaments CAMZYOS (mavacamten) - Commission de la Transparence du 6 septembre 2023', n.population_cible_min = null, n.population_cible_max = null, n.population_cible_texte_brut = null, n.population_cible_source_type = null, n.population_cible_commentaire_commission = null;
