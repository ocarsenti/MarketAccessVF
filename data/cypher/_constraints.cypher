CREATE CONSTRAINT IF NOT EXISTS FOR (pp:Population) REQUIRE pp.canonical_id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (a:Argument) REQUIRE a.canonical_id IS UNIQUE;
